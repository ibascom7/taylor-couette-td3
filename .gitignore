# OpenFOAM per-task scratch case copies (huge, regenerated every run)
_runs/
taylorCouetteGym/_runs/

# SLURM logs
logs/
taylorCouetteGym/logs/

# Python caches
__pycache__/
*.pyc

# Editor swap files
*.swp

# NOTE: results/ is intentionally NOT ignored -- the .npy logs + checkpoints
# are what you push to GitHub and pull down to plot locally.

# ...EXCEPT the raw OpenFOAM frame trees captured for ParaView: each is many
# small files (hundreds per sweep). Keep the trees out of git and commit the
# frames.tgz tarball beside them instead (see pack_frames.sh). The tarball is
# NOT under frames/, so it is not matched by these rules.
results/**/frames/
taylorCouetteGym/results/**/frames/
**/frames_constant/
**/frames_squarewave/
.venv/
**/frames*/
**/paraview/

# --- OpenFOAM result-case clones under experiments/ (2026-08-04) -----------
# Time folders, meshes, templates: tens of GB, all regenerable from the
# tracked master cases + sweep scripts. The sibling CSVs / PNGs / .npy logs
# (the science record) stay tracked. Deliberately scoped to experiments/ so
# the MASTER cases under taylor_couette_mixing/cases/ are never matched.
taylorCouetteGym/experiments/**/side_outlet_case*/
taylorCouetteGym/experiments/**/side_outlet_grad_case/
taylorCouetteGym/experiments/**/full_tc_grad_case/
taylorCouetteGym/experiments/**/rpm_*/
taylorCouetteGym/experiments/**/constant_wb*/
taylorCouetteGym/experiments/**/pulsed_wb*/
taylorCouetteGym/experiments/**/_template/
taylorCouetteGym/experiments/**/case/
taylorCouetteGym/experiments/**/case_work/
taylorCouetteGym/experiments/**/workers/
**/dynamicCode/
**/processor[0-9]*/

# OpenFOAM solver/utility logs (regenerable; log.pimpleFoam can exceed
# GitHub's hard 100 MB per-file cap)
log.pimpleFoam
log.blockMesh
log.checkMesh
log.warmup
log.compile
log.err
