FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// Lopez silicone oil: rho = 930 kg/m3, mu = 0.01 Pa s.
// pimpleFoam uses nu = mu/rho.

transportModel  Newtonian;

rho             rho [1 -3 0 0 0 0 0] 930;
mu              mu  [1 -1 -1 0 0 0 0] 0.01;
nu              nu  [0 2 -1 0 0 0 0] 1.0752688172043011e-05;

// Diluted-species diffusivity D = 1e-9 m2/s (Lopez-Guajardo, corrected 2026-07;
// Sc = nu/D ~= 1e4). Must match the scalarTransport D in system/controlDict.
D               D   [0 2 -1 0 0 0 0] 1e-9;

