FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     pimpleFoam;

// latestTime (NOT startTime): the RL env / sweep step pimpleFoam forward in
// chunks, CONTINUING from the last written time dir (they only bump endTime).
// See the step-loop contract memory.
startFrom       latestTime;
startTime       0;

stopAt          endTime;
endTime         2;          // placeholder; the env/sweep set this each step

deltaT          1e-3;
adjustTimeStep  yes;
maxCo           1.5;
maxDeltaT       0.05;

writeControl    adjustableRunTime;
writeInterval   1;          // one field dir per simulated second (env step boundary);
                            // adjustableRunTime nudges dt to land exactly on integer
                            // seconds so _get_latest_time() stays on the step grid

purgeWrite      0;
writeFormat     ascii;
writePrecision  9;
writeCompression no;
timeFormat      general;
timePrecision   9;
runTimeModifiable no;

functions
{
    // ---- reactant transport (catalysis scalar C) ----------------------------
    scalarTransport
    {
        type            scalarTransport;
        libs            ( solverFunctionObjects );
        field           C;
        resetOnStartUp  false;
        schemesField    C;
        D               1e-9;       // must match transportProperties.D below
        nCorr           1;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;

        // ---- CATALYTIC WALL MASS-TRANSFER MODEL --------------------------------
        // The reactant is consumed at the catalytic OUTER wall at a rate limited
        // by transport across the ~micron concentration film, which the coarse
        // mesh cannot resolve. Instead of resolving it, we model the film with a
        // mass-transfer coefficient k_c from a Sherwood correlation
        //     Sh = a * Re^b * Sc^c      (Eisenberg-Tobias-Wilke rotating cylinder)
        // so the wall flux RESPONDS to rotation. Applied as an IMPLICIT volumetric
        // sink k_c*(A_wall/V)*C in the wall-adjacent cells (bounded at any Sh).
        //   Re = |U_inner|*d/nu  (|U_inner| ~ omega*Ri, read live from the field)
        //   k_c = Sh*D/d,   d = Ro-Ri (gap)
        // TUNE the prefactor a_pref (geometry knob) -- shape (b,c) is physics.
        fvOptions
        {
            wallMassTransfer
            {
                type            scalarCodedSource;
                selectionMode   all;          // filtered to outer_wall cells in code
                fields          (C);
                name            wallMassTransfer;

                codeInclude
                #{
                    #include "fvCFD.H"
                #};

                codeOptions
                #{
                    -I$(LIB_SRC)/finiteVolume/lnInclude
                #};

                codeLibs
                #{
                    -lfiniteVolume
                #};

                codeCorrect
                #{
                #};

                codeConstrain
                #{
                #};

                codeAddSup
                #{
                    // ---- correlation + geometry constants (TUNE a_pref) ----
                    const scalar a_pref = 0.0791;   // ETW prefactor (geometry knob)
                    const scalar b_exp  = 0.70;     // Reynolds exponent
                    const scalar c_exp  = 0.356;    // Schmidt exponent
                    const scalar Sh_min = 1.0;      // residual (diffusive) floor
                    const scalar Ri = 0.0254;       // inner radius [m]
                    const scalar Ro = 0.03175;      // outer radius [m]
                    const scalar d  = Ro - Ri;      // gap [m] = char. length

                    const fvMesh& m = mesh_;

                    // --- fluid properties (nu, D) ---
                    IOdictionary transportProperties
                    (
                        IOobject
                        (
                            "transportProperties", m.time().constant(), m,
                            IOobject::MUST_READ_IF_MODIFIED, IOobject::NO_WRITE
                        )
                    );
                    const scalar nu = dimensionedScalar("nu", dimViscosity, transportProperties).value();
                    const scalar Dm = dimensionedScalar("D",  dimViscosity, transportProperties).value();
                    const scalar Sc = nu/Dm;

                    // --- rotation -> Reynolds from inner-wall speed |U| ~ omega*Ri ---
                    const volVectorField& U = m.lookupObject<volVectorField>("U");
                    const label inID = m.boundaryMesh().findPatchID("inner_wall");
                    scalar Uwall = 0.0;
                    if (inID >= 0 && m.boundary()[inID].size() > 0)
                    {
                        Uwall = gAverage(mag(U.boundaryField()[inID]));
                    }
                    const scalar Re = Uwall*d/nu;
                    scalar Sh = a_pref*Foam::pow(max(Re, SMALL), b_exp)*Foam::pow(Sc, c_exp);
                    Sh = max(Sh, Sh_min);
                    const scalar kc = Sh*Dm/d;          // mass-transfer coeff [m/s]

                    // --- implicit sink kc*(A_face/V_cell)*C in outer_wall cells ---
                    volScalarField sinkCoeff
                    (
                        IOobject
                        (
                            "wallMTsinkCoeff", m.time().timeName(), m,
                            IOobject::NO_READ, IOobject::NO_WRITE, IOobject::NO_REGISTER
                        ),
                        m,
                        dimensionedScalar(dimless/dimTime, Zero)
                    );
                    const label outID = m.boundaryMesh().findPatchID("outer_wall");
                    if (outID >= 0)
                    {
                        const fvPatch& op = m.boundary()[outID];
                        const labelUList& fc = op.faceCells();
                        const scalarField& magSf = op.magSf();
                        const scalarField& Vc = m.V();
                        forAll(fc, i)
                        {
                            sinkCoeff[fc[i]] += kc*magSf[i]/Vc[fc[i]];
                        }
                    }

                    eqn -= fvm::Sp(sinkCoeff, eqn.psi());
                #};
            }
        }
    }

    // ---- METRICS line for the env / hysteresis sweep ------------------------
    // Emits, every `executeInterval` steps:
    //   Mz_kin  : kinematic torque on the inner wall about z (env multiplies by
    //             rho to get N.m; mech power = rho*|Mz_kin|*omega)
    //   conv    : outlet conversion 1 - cupC, cup-mixing weighted by the face
    //             flux phi at the SIDE outlet (radial outflow -> weight by phi,
    //             not by axial velocity as a bottom outlet would)
    //   wallFlux: catalytic consumption rate at the outer wall, -D * dC/dn * dA
    rlMetrics
    {
        type            coded;
        libs            ( utilityFunctionObjects );
        name            rlMetrics;

        executeControl  timeStep;
        executeInterval 20;

        codeInclude
        #{
            #include "fvCFD.H"
        #};

        codeOptions
        #{
            -I$(LIB_SRC)/finiteVolume/lnInclude
        #};

        codeLibs
        #{
            -lfiniteVolume
        #};

        codeExecute
        #{
            const fvMesh& mesh = refCast<const fvMesh>(obr_);
            const Time& runTime = mesh.time();

            const volScalarField& C = mesh.lookupObject<volScalarField>("C");
            const volVectorField& U = mesh.lookupObject<volVectorField>("U");
            const surfaceScalarField& phi =
                mesh.lookupObject<surfaceScalarField>("phi");

            // transport properties (nu for the torque, D for the wall flux)
            IOdictionary transportProperties
            (
                IOobject
                (
                    "transportProperties",
                    runTime.constant(),
                    mesh,
                    IOobject::MUST_READ_IF_MODIFIED,
                    IOobject::NO_WRITE
                )
            );
            const scalar nu = dimensionedScalar("nu", dimViscosity, transportProperties).value();
            const scalar Dmol = dimensionedScalar("D", dimViscosity, transportProperties).value();

            // ---------- inner-wall kinematic torque about z ----------
            scalar Mz = 0.0;
            const label innerID = mesh.boundaryMesh().findPatchID("inner_wall");
            if (innerID >= 0)
            {
                const volTensorField gradU(fvc::grad(U));
                const fvPatchTensorField& gradUp = gradU.boundaryField()[innerID];
                const fvPatch& pIn = mesh.boundary()[innerID];
                const vectorField& Cf = pIn.Cf();
                const vectorField& Sf = pIn.Sf();
                forAll(Cf, i)
                {
                    const tensor g = gradUp[i];
                    // kinematic viscous traction * area  =  nu*(gradU + gradU^T) . Sf
                    const vector tr = nu*((g + g.T()) & Sf[i]);
                    Mz += (Cf[i] ^ tr).z();
                }
            }
            reduce(Mz, sumOp<scalar>());

            // ---------- side-outlet cup-mixing conversion (phi weighted) ----------
            scalar num = 0.0, den = 0.0;
            const label outID = mesh.boundaryMesh().findPatchID("side_outlet");
            if (outID >= 0)
            {
                const fvPatchScalarField& Cp = C.boundaryField()[outID];
                const fvsPatchScalarField& phip = phi.boundaryField()[outID];
                forAll(Cp, i)
                {
                    const scalar f = phip[i];
                    if (f > 0.0) { den += f; num += f*Cp[i]; }
                }
            }
            reduce(num, sumOp<scalar>());
            reduce(den, sumOp<scalar>());
            const scalar cupC = (den > VSMALL) ? num/den : 0.0;
            const scalar conv = 1.0 - cupC;   // feed c0 = 1

            // ---------- catalytic outer-wall consumption flux (MODELED) ----------
            // Wall consumption is now handled by the wallMassTransfer coded
            // fvOption (implicit sink k_c*C in the wall cells), NOT by a resolved
            // gradient, so report the MODELED flux  sum(k_c * C_P * A). k_c must
            // match the source: Sh = a*Re^b*Sc^c, k_c = Sh*D/d.  (keep in sync!)
            const scalar a_pref = 0.0791, b_exp = 0.70, c_exp = 0.356, Sh_min = 1.0;
            const scalar Ri_ = 0.0254, Ro_ = 0.03175, d_ = Ro_ - Ri_;
            const scalar Sc_ = nu/Dmol;
            scalar Uwall = 0.0;
            const label inID2 = mesh.boundaryMesh().findPatchID("inner_wall");
            if (inID2 >= 0 && mesh.boundary()[inID2].size() > 0)
            {
                Uwall = gAverage(mag(U.boundaryField()[inID2]));
            }
            const scalar Re_ = Uwall*d_/nu;
            scalar Sh_ = a_pref*Foam::pow(max(Re_, SMALL), b_exp)*Foam::pow(Sc_, c_exp);
            Sh_ = max(Sh_, Sh_min);
            const scalar kc_ = Sh_*Dmol/d_;

            scalar wallFlux = 0.0;
            const label outerID = mesh.boundaryMesh().findPatchID("outer_wall");
            if (outerID >= 0)
            {
                const fvPatch& op = mesh.boundary()[outerID];
                const labelUList& fc = op.faceCells();
                const scalarField& magSf = op.magSf();
                forAll(fc, i) wallFlux += kc_*C[fc[i]]*magSf[i];
            }
            reduce(wallFlux, sumOp<scalar>());

            Info<< "MODELINFO Uwall=" << Uwall << " Re=" << Re_
                << " Sh=" << Sh_ << " kc=" << kc_ << endl;

            Info<< "METRICS t=" << runTime.value()
                << " Mz_kin=" << Mz
                << " conv=" << conv
                << " cupC=" << cupC
                << " wallFlux=" << wallFlux
                << endl;
        #};
    }
}

