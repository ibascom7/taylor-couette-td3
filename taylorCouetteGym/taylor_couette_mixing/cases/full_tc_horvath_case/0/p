// Kinematic pressure (p/rho). Pressure reference fixed at the bottom outlet.
FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    object          p;
}

dimensions      [ 0 2 -2 0 0 0 0 ];

internalField   uniform 0;

boundaryField
{
    inner_wall
    {
        type            zeroGradient;
    }
    outer_wall
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    bottom
    {
        type            fixedValue;
        value           uniform 0;
    }
}

