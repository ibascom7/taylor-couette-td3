FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     pimpleFoam;

// side_outlet_case_bottomavg: byte-identical clone of side_outlet_case (same mesh,
// physics, BCs) EXCEPT the conversion measurement. Wang/Yuhe asked for cOut to be the
// AVERAGE CONCENTRATION OF THE CELLS AT THE BOTTOM OF THE CONTAINER instead of the
// flux-weighted (cup-mixing) average over the side_outlet patch. See the
// bottomCellsConversion functionObject below -- the only changed block in this case.

// Each spin-sweep episode is an INDEPENDENT run from t=0 (startTime), so no
// latestTime continuation here. endTime is a placeholder; the sweep script sets
// it per episode (foamDictionary endTime) to the requested duration.
startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         180;        // placeholder; the sweep script sets this per episode

deltaT          0.01;

writeControl    adjustableRunTime;
writeInterval   10;         // field dirs for ParaView; conversion/power sampled
                            // separately at 1 Hz by the coded FOs below

purgeWrite      0;

writeFormat     ascii;
writePrecision  8;
writeCompression no;

timeFormat      general;
timePrecision   6;

runTimeModifiable no;

adjustTimeStep  yes;
maxCo           1.8;
maxDeltaT       0.05;

functions
{
    scalarTransport
    {
        type            scalarTransport;
        libs            ( solverFunctionObjects );

        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;

        field           c;
        resetOnStartUp  false;
        schemesField    c;
        D               1e-9;       // matches constant/transportProperties (Sc ~ 1e4)
        nCorr           1;
    }

    bottomCellsConversion
    {
        type            coded;
        libs            ( utilityFunctionObjects );
        name            bottomCellsConversion;

        // Sample conversion every 1 s of sim time (independent of field writes) so
        // the sweep gets a clean approach-to-steady-state time series.
        executeControl  adjustableRunTime;
        executeInterval 1.0;
        writeControl    adjustableRunTime;
        writeInterval   1.0;

        codeInclude
        #{
            #include "fvCFD.H"
            #include <fstream>
        #};

        codeOptions
        #{
            -I$(LIB_SRC)/finiteVolume/lnInclude
        #};

        codeLibs
        #{
            -lfiniteVolume
        #};

        codeExecute
        #{
            const fvMesh& mesh = refCast<const fvMesh>(obr_);
            const volScalarField& c = mesh.lookupObject<volScalarField>("c");
            const surfaceScalarField& phi = mesh.lookupObject<surfaceScalarField>("phi");

            const scalar c0 = 50.0;

            // NEW MEASUREMENT (Wang/Yuhe): cOut = VOLUME-WEIGHTED AVERAGE concentration
            // of the cells at the BOTTOM of the container -- the 1-cell-tall axial band
            // adjacent to the closed bottom wall (the same band the side outlet drains
            // from). blockMeshDict: that band spans z in [-0.01905, -0.0186266667], so
            // select cells whose centre lies below the band's top face. Volume weighting
            // because wedge cell volumes grow with radius.
            const scalar zBandTop = -0.0186266667;

            const scalarField& V = mesh.V();
            const volVectorField& C = mesh.C();

            scalar sumV  = 0.0;
            scalar sumVC = 0.0;
            label  nBand = 0;

            forAll(V, cellI)
            {
                if (C[cellI].z() < zBandTop)
                {
                    sumV  += V[cellI];
                    sumVC += V[cellI]*c[cellI];
                    ++nBand;
                }
            }

            reduce(sumV, sumOp<scalar>());
            reduce(sumVC, sumOp<scalar>());
            reduce(nBand, sumOp<label>());

            const scalar cOut = sumVC/max(sumV, VSMALL);
            const scalar conversion = 1.0 - cOut/c0;

            // REFERENCE (old measurement, same run): flux-weighted cup-mixing average
            // over the side_outlet patch, logged alongside so a single run compares the
            // two measurement styles directly.
            const label patchI = mesh.boundaryMesh().findPatchID("side_outlet");
            if (patchI < 0)
            {
                FatalErrorInFunction << "Patch side_outlet was not found." << exit(FatalError);
            }

            const fvPatchScalarField& cp = c.boundaryField()[patchI];
            const fvsPatchScalarField& phip = phi.boundaryField()[patchI];

            scalar sumOutPhi = 0.0;
            scalar sumOutPhiC = 0.0;

            forAll(cp, faceI)
            {
                const scalar phif = phip[faceI];
                if (phif > 0.0)
                {
                    sumOutPhi  += phif;
                    sumOutPhiC += phif*cp[faceI];
                }
            }

            reduce(sumOutPhi, sumOp<scalar>());
            reduce(sumOutPhiC, sumOp<scalar>());

            const scalar cCup = sumOutPhiC/max(sumOutPhi, VSMALL);
            const scalar convCup = 1.0 - cCup/c0;

            fileName outDir = mesh.time().path()/"postProcessing"/"bottomCellsConversion"/"0";
            mkDir(outDir);
            fileName outFile = outDir/"bottomCellsConversion.dat";

            std::ios_base::openmode mode = std::ios::app;
            if (mesh.time().timeIndex() <= 1 || mesh.time().value() <= SMALL)
            {
                mode = std::ios::out;
            }

            std::ofstream os(outFile.c_str(), mode);
            if (mesh.time().timeIndex() <= 1 || mesh.time().value() <= SMALL)
            {
                os << "# time cBottom_mmol_per_m3 conversion nBottomCells cOutletCup_mmol_per_m3 conversionOutletCup" << std::endl;
            }

            os  << mesh.time().value() << ' '
                << cOut << ' '
                << conversion << ' '
                << nBand << ' '
                << cCup << ' '
                << convCup << std::endl;

            Info<< "BOTTOM_CELLS_CONVERSION"
                << " t=" << mesh.time().value()
                << " cOut=" << cOut
                << " conversion=" << conversion
                << " nCells=" << nBand
                << " cOutletCup=" << cCup
                << " convOutletCup=" << convCup
                << nl;
        #};
    }

    rotationalPower_innerWall
    {
        type            coded;
        libs            ( utilityFunctionObjects );
        name            rotationalPower_innerWall;

        // Sample power every 1 s of sim time (see sideOutletConversion above).
        executeControl  adjustableRunTime;
        executeInterval 1.0;
        writeControl    adjustableRunTime;
        writeInterval   1.0;

        codeInclude
        #{
            #include "fvCFD.H"
            #include <fstream>
        #};

        codeOptions
        #{
            -I$(LIB_SRC)/finiteVolume/lnInclude
        #};

        codeLibs
        #{
            -lfiniteVolume
        #};

        codeExecute
        #{
            const fvMesh& mesh = refCast<const fvMesh>(obr_);
            const volVectorField& U = mesh.lookupObject<volVectorField>("U");

            const label patchI = mesh.boundaryMesh().findPatchID("inner_wall");
            if (patchI < 0)
            {
                FatalErrorInFunction << "Patch inner_wall was not found." << exit(FatalError);
            }

            IOdictionary transportProperties
            (
                IOobject
                (
                    "transportProperties",
                    mesh.time().constant(),
                    mesh,
                    IOobject::MUST_READ_IF_MODIFIED,
                    IOobject::NO_WRITE
                )
            );

            const dimensionedScalar nuDim("nu", dimViscosity, transportProperties);
            const dimensionedScalar rhoDim("rho", dimDensity, transportProperties);
            const scalar nu = nuDim.value();
            const scalar rho = rhoDim.value();

            const scalar fullScale = 72.0;

            const fvPatch& p = mesh.boundary()[patchI];
            const vectorField& Cf = p.Cf();
            const scalarField& magSf = p.magSf();

            const volTensorField gradU(fvc::grad(U));
            const fvPatchTensorField& gradUp = gradU.boundaryField()[patchI];
            const fvPatchVectorField& Uw = U.boundaryField()[patchI];

            scalar MzWedge = 0.0;
            scalar sumOmegaA = 0.0;
            scalar sumA = 0.0;

            forAll(Cf, faceI)
            {
                const scalar x = Cf[faceI].x();
                const scalar y = Cf[faceI].y();
                const scalar r = sqrt(sqr(x) + sqr(y));

                if (r > SMALL)
                {
                    const vector eTheta(-y/r, x/r, 0.0);
                    const scalar Af = magSf[faceI];
                    const vector nHat = p.Sf()[faceI]/Af;

                    const tensor grad = gradUp[faceI];
                    const vector traction = rho*nu*((grad + grad.T()) & nHat);

                    MzWedge += ((Cf[faceI] ^ (traction*Af)) & vector(0, 0, 1));
                    sumOmegaA += ((Uw[faceI] & eTheta)/r)*Af;
                    sumA += Af;
                }
            }

            reduce(MzWedge, sumOp<scalar>());
            reduce(sumOmegaA, sumOp<scalar>());
            reduce(sumA, sumOp<scalar>());

            const scalar Omega = sumOmegaA/max(sumA, VSMALL);
            const scalar P_wedge = mag(MzWedge*Omega);
            const scalar P_full = fullScale*P_wedge;

            fileName outDir = mesh.time().path()/"postProcessing"/"rotationalPower_innerWall"/"0";
            mkDir(outDir);
            fileName outFile = outDir/"rotationalPower.dat";

            std::ios_base::openmode mode = std::ios::app;
            if (mesh.time().timeIndex() <= 1 || mesh.time().value() <= SMALL)
            {
                mode = std::ios::out;
            }

            std::ofstream os(outFile.c_str(), mode);
            if (mesh.time().timeIndex() <= 1 || mesh.time().value() <= SMALL)
            {
                os << "# time Omega_rad_per_s Mz_wedge_Nm P_wedge_W P_full_360deg_W rho_kg_per_m3 nu_m2_per_s fullScale" << std::endl;
            }

            os  << mesh.time().value() << ' '
                << Omega << ' '
                << MzWedge << ' '
                << P_wedge << ' '
                << P_full << ' '
                << rho << ' '
                << nu << ' '
                << fullScale << std::endl;

            Info<< "ROTATIONAL_POWER"
                << " t=" << mesh.time().value()
                << " Omega=" << Omega
                << " Mz_wedge=" << MzWedge
                << " P_full=" << P_full
                << " file=" << outFile
                << nl;
        #};
    }
}

