            {
                const vector nHat = Sf[faceI]/mag(Sf[faceI]);
                // Top inlet outward normal points +z; inflow is opposite to it.
                Uin[faceI] = -scale*shape[faceI]*nHat;
            }

            operator==(Uin);
        #};
    }
    bottom
    {
        type            noSlip;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
}


