            reduce(sumShapeA, sumOp<scalar>());
            reduce(sumA, sumOp<scalar>());

            const scalar meanShape = sumShapeA/max(sumA, VSMALL);
            const scalar scale = Umean/max(meanShape, VSMALL);

            forAll(Cf, faceI)
