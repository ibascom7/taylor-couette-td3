FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-6;
        relTol          0.01;
    }

    pFinal
    {
        $p;
        relTol          0;
    }

    "(U|k|omega|epsilon)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
    }

    "(U|k|omega|epsilon)Final"
    {
        $U;
        relTol          0;
    }

    C
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }

    CFinal
    {
        $C;
        relTol          0;
    }
}

PIMPLE
{
    // 2 -> 1 outer corrector (PISO-like): ~2x faster per step (measured
    // 135 -> ~49 s wall/sim-second). Safe for this smooth laminar TC flow at
    // Co <= 1.5; momentum-pressure coupling is solved once per step. If a
    // converged conversion ever looks off, revert to 2 to check the coupling.
    nOuterCorrectors    1;
    nCorrectors         1;
    nNonOrthogonalCorrectors 0;

    pRefCell  0;
    pRefValue 0;
}

