            const scalar pi = 3.1415926535897932384626433832795;

            const scalar Aann = pi*(sqr(Ro) - sqr(Ri));
            const scalar Umean = Q0/Aann;

            scalarField shape(p.size(), scalar(0));
            scalar sumShapeA = scalar(0);
            scalar sumA = scalar(0);

