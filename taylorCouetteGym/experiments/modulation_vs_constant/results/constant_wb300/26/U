            vectorField Uin(p.size(), vector::zero);

            const vectorField& Cf = p.Cf();
            const vectorField& Sf = p.Sf();

            const scalar Ri = 0.0254;
            const scalar Ro = 0.03175;
            const scalar Q0 = 100e-6/60.0;  // full 360-degree flow rate [m3/s]
