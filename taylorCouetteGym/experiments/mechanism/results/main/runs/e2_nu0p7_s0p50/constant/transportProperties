FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          transportProperties;
}

transportModel  Newtonian;

rho             rho [ 1 -3 0 0 0 0 0 ] 930;

mu              mu [ 1 -1 -1 0 0 0 0 ] 0.007;

nu              nu [ 0 2 -1 0 0 0 0 ] 7.52688e-06;

D               D [ 0 2 -1 0 0 0 0 ] 1e-08;


